# ClickCraft Site Monitor — example environment configuration
# Copy to .env on the VPS and fill in real values there. NEVER commit .env.

# ---------- Application ----------
NODE_ENV=production
APP_PORT=4000
APP_PUBLIC_URL=https://monitor.example-domain.tld
APP_NAME=ClickCraft Site Monitor
APP_TIMEZONE=Africa/Johannesburg
TRUST_PROXY=true

# Host port published on the VPS (container port stays APP_PORT).
# Only needed for local debugging — Nginx Proxy Manager reaches the app
# over the shared Docker proxy network instead. Keep bound to 127.0.0.1
# and never publish this to the public internet.
HOST_BIND_ADDRESS=127.0.0.1
HOST_PORT=4000

# ---------- Shared proxy network (Nginx Proxy Manager) ----------
# External Docker network shared with NPM. Create it once on the VPS:
#   docker network create npm-proxy
# NPM then proxies to http://clickcraft-monitor-app:4000
PROXY_NETWORK_NAME=npm-proxy

# ---------- PostgreSQL ----------
POSTGRES_DB=clickcraft_monitor
POSTGRES_USER=clickcraft
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ---------- Authentication ----------
# Long random string, e.g. `openssl rand -base64 48`
SESSION_SECRET=replace-with-a-long-random-session-secret
SESSION_TTL_HOURS=12

# Initial administrator, created on first start only (minimum 12 characters)
ADMIN_EMAIL=admin@example-domain.tld
ADMIN_PASSWORD=replace-with-a-strong-administrator-password

# ---------- Telegram notifications (optional) ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------- SMTP email notifications (optional) ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_FROM=
ALERT_EMAIL_TO=

# ---------- Monitoring engine ----------
WORKER_CONCURRENCY=8
WORKER_TICK_INTERVAL_MS=10000
# SSRF guard: keep false unless you deliberately monitor internal addresses
ALLOW_PRIVATE_TARGETS=false
PRIVATE_TARGET_ALLOWLIST=

# ---------- Host / Docker visibility (optional) ----------
# Requires the read-only mounts described in the README
HOST_PROC_PATH=/host/proc
HOST_ROOT_PATH=/host/root
# Leave empty to disable Docker container monitoring entirely
DOCKER_SOCKET_PATH=

# ---------- Development helpers ----------
SEED_DEMO_SITES=false
